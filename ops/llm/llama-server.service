[Unit]
Description=llama.cpp server - router mod (Myra)
After=network-online.target

[Service]
User=myra-llm
EnvironmentFile=/etc/myra/llama-server.env
ExecStart=${LLAMA_SERVER_BIN} --models-preset ${LLAMA_MODELS_PRESET} --models-max ${LLAMA_MODELS_MAX} --host ${LLAMA_HOST} --port ${LLAMA_PORT} --api-key ${LLAMA_API_KEY}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
