[Unit]
Description=Myra futasideju figyelo es karanten (docker events + backend log + integritas)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=myra-admin
EnvironmentFile=/etc/myra/ops.env
ExecStart=/usr/bin/python3 ${MYRA_DIR}/ops/myra-watch.py
Restart=always
RestartSec=15




MemoryMax=192M
CPUQuota=10%

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
