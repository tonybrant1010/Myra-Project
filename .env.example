MYRA_PROXY_SECRET=
MYRA_SMTP_PASSWORD=

MYRA_SMTP_USER=
MYRA_MAIL_FROM=
MYRA_MAIL_FROM_NAME=Myra-project
ADMIN_EMAIL_ALLOWLIST=
MYRA_ALERT_EMAIL=

