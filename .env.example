# Myra backend – környezeti változók mintája
#
# Ez a fájl a `.env` sablonja. A titkok maradjanak üresen és ne kerüljenek
# verziókövetésbe. Új telepítés előtt töltsd ki a szükséges értékeket.
#
# Használat:   cp .env.example .env   majd töltsd ki a TITOK jelölésű sorokat.
#
# Amit a backend ténylegesen megkap, azt a docker-compose.yml `environment`
# szakasza dönti el. Ha új változót veszel fel ide, oda is fel kell venni,
# különben soha nem jut el a konténerbe.


# ---------------------------------------------------------------- TITKOK
# Ezeket kézzel töltsd ki. Üresen a backend el sem indul (a compose `:?` jelöli).

JWT_SECRET=
# PostgreSQL kapcsolat:
DATABASE_URL=
# A helyi PostgreSQL (db szolgaltatas) jelszoja. A backend alapbol ezt hasznalja
# (DATABASE_URL=...@db:5432/myra), ezert kotelezo.
DB_PASSWORD=
BACKUP_HOST_DIR=./backups
# A fordított proxy (Caddy) és a backend közös titka:
MYRA_PROXY_SECRET=
# Proton SMTP token (Proton Mail: Settings -> All settings -> IMAP/SMTP ->
# SMTP tokens). A Proton-fiók bejelentkezési jelszava NEM működik helyette.
# Enélkül egyetlen levél sem megy ki.
# Proton Mail Bridge használatakor a Bridge `info` parancsa által adott jelszó.
MYRA_SMTP_PASSWORD=


# ------------------------------------------------------- SZEMÉLYES ADATOK
# Nem titkosak, de e-mail címek — új telepítésnél a sajátodat írd be.

# A saját domaines cím, amiről a levelek mennek (a Proton-fiókban léteznie kell).
# Proton Mail Bridge használatakor a Bridge `info` parancsának „Username” sora.
MYRA_SMTP_USER=
# A feladó címe. A Proton-fiókban léteznie kell, különben a Bridge elutasítja.
MYRA_MAIL_FROM=
# A feladó megjelenő neve a levelekben:
MYRA_MAIL_FROM_NAME=Myra-project
# Adminisztrátori bejelentkezésre engedélyezett címek, vesszővel elválasztva:
ADMIN_EMAIL_ALLOWLIST=
# Ide mennek a belső riasztások: krízisjelzés, visszajelzés, belépés-riasztás,
# valamint a myra-watch és a deploy szkript üzenetei. Üresen a MYRA_MAIL_FROM-ra küld.
MYRA_ALERT_EMAIL=


# -------------------------------------------------------- E-MAIL (PROTON)
# A leveleket a konfigurált Proton Mail-fiók küldi.
# Telepítés, DNS (MX, SPF, DKIM, DMARC) és üzemeltetés:
# docs/email-proton-atallas.md

# A Proton közvetlen SMTP-beküldője. Feltétele: a domain hitelesítve a
# Protonban, és készült SMTP token (Settings -> IMAP/SMTP -> SMTP tokens).
MYRA_SMTP_HOST=smtp.protonmail.ch
MYRA_SMTP_PORT=587
# "starttls" (a Proton és a Bridge is így figyel), "ssl" (implicit TLS),
# "none" (titkosítás nélkül — csak helyi teszthez).
MYRA_SMTP_SECURITY=starttls
# A Proton végpontja valódi tanúsítvánnyal jön: maradjon true.
MYRA_SMTP_TLS_VERIFY=true
MYRA_SMTP_TIMEOUT_S=30

# --- Tartalék út: Proton Mail Bridge a szerveren -------------------------
# Ha a fiókban nincs SMTP token, a Bridge viszi ki a leveleket. Indítás:
#     docker compose --profile bridge up -d
# Ilyenkor a backend konténernek:
#     MYRA_SMTP_HOST=proton-bridge
#     MYRA_SMTP_PORT=25
#     MYRA_SMTP_TLS_VERIFY=false      # a Bridge önaláírt tanúsítványa miatt
# a hoszton futó szkripteknek (myra-watch, myra-deploy) pedig:
#     MYRA_SMTP_HOST_LOCAL=127.0.0.1
#     MYRA_SMTP_PORT_LOCAL=1025
# (A _LOCAL változók csak a Bridge-nél számítanak; közvetlen Proton SMTP-nél a
#  szkriptek ugyanazt a MYRA_SMTP_HOST / MYRA_SMTP_PORT értéket használják.)


# ------------------------------------------------------------- ADATBÁZIS
# A compose PostgreSQL helyi kapcsolatánál nincs TLS; külső adatbázisnál állítsd true-ra.
DATABASE_SSL=false
DATABASE_SSL_MODE=require


# ---------------------------------------------------------------- HÁLÓZAT
# Proxy mögötti telepítésnél állítsd true-ra, és csak megbízható proxy esetén használd.
TRUST_PROXY=false


# ----------------------------------------------------------- FELOLVASÁS
# Értéke "piper" vagy "none". Élesben: piper — a felolvasás a saját szerveren
# fut, hanganyag külső szolgáltatóhoz nem kerül. A Gemini-alapú felolvasás
# 2026 októberében megszűnt; a GEMINI_TTS_* változókat a kód nem olvassa.
TTS_ENGINE=piper


# ------------------------------------------------- A GEMININEK KÜLDÖTT CSOMAG
# Ez a négy érték dönti el, mekkora és milyen tartalmú prompt megy ki
# fordulónként. 2026-08-17-i beállítás.

# Hány PDF-részlet mehet legfeljebb egy üzenethez. 0 = a tudásanyag teljesen
# kimarad (és a keresés is elmarad, ami kérésenként 2-8 másodpercet spórol).
RAG_CHAT_CHUNKS=5

# Ennél lazább találat nem megy át. Kisebb szám = szigorúbb szűrés.
# 1.0 = nincs szűrés, minden találat átmegy.
RAG_VECTOR_MAX_DISTANCE=0.62

# Hány jelöltet hoz fel a hibrid (vektor + szöveges) keresés, mielőtt rangsorol.
RAG_CANDIDATE_POOL=20

# Milyen sűrűn tartja melegen az embedding modellt, hogy ne lapozódjon ki.
# 0 = kikapcsolva.
RAG_KEEPWARM_INTERVAL_S=240

# A beágyazó modell 128 tokennél elvág (magyar szakszövegen ~500 karakter).
# Ennél nagyobb darab vége nem kerül a vektorba. Változtatás után újraindexelés kell.
RAG_CHUNK_MAX_CHARS=400
RAG_CHUNK_OVERLAP=80


# ---------------------------------------------------------- ELŐZMÉNY
# Mennyit lát a modell a beszélgetésből. A kód felső határa 300 üzenet és
# 120000 karakter — ennél többhöz a server.py-t is módosítani kell.
CHAT_HISTORY_MAX_MESSAGES=120
CHAT_HISTORY_MAX_CHARS=45000

# Helyi LLM-szerver (llama-server --api-key) kulcsa; ugyanaz, mint a szerver szolgaltatasban.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_API_KEY=
LOCAL_LLM_BRANCH=0
LOCAL_LLM_MODE=fallback
LOCAL_FALLBACK_TIMEOUT_S=120
OLLAMA_TIMEOUT_S=300
LLM_METRICS=0
